<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
	<AssemblyName>JniSharpGenerator.exe</AssemblyName>
	<OutputPath>bin\x64\$(Configuration)\</OutputPath>
	<PublishAot>true</PublishAot>
	<PublishDir>bin\x64\$(Configuration)\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JniSharpGenerator\JniSharpGenerator.csproj" />
  </ItemGroup>

</Project>
